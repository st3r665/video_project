# ===== 工具链（体积大，不入库，按 README 说明自行下载）=====
jdk-17/
apache-maven-3.9.16/
*.zip

# ===== Java 构建产物 =====
target/
*.class
*.jar
!video-platform-java/**/src/**

# ===== 运行时数据与日志 =====
data/
*.log
*.db
*.db-wal
*.db-shm

# ===== Python 缓存 =====
__pycache__/
*.pyc
*.pyo

